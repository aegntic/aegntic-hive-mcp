{
  "name": "aegntic-hive-mcp",
  "version": "1.0.0",
  "description": "MCP server for managing AI conversations, projects, and artifacts from ChatGPT, Grok, Gemini, and Claude",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "test:unit": "jest --testPathPattern=unit --detectOpenHandles",
    "test:integration": "jest --testPathPattern=integration --detectOpenHandles",
    "test:e2e": "jest --testPathPattern=e2e --detectOpenHandles",
    "test:parallel": "jest --maxWorkers=4 --detectOpenHandles --forceExit",
    "test:tdd": "jest --watch --testPathPattern=unit --verbose",
    "test:performance": "jest --testPathPattern=performance --detectOpenHandles",
    "test:runner": "node scripts/test-runner.js",
    "test:runner:tdd": "node scripts/test-runner.js tdd",
    "test:runner:watch": "node scripts/test-runner.js watch",
    "test:runner:all": "node scripts/test-runner.js all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "puppeteer": "^21.0.0",
    "cheerio": "^1.0.0-rc.12",
    "sqlite3": "^5.1.6",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "natural": "^6.0.0",
    "compromise": "^14.0.0",
    "fuse.js": "^6.6.2",
    "stopword": "^2.0.0",
    "stemmer": "^2.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "supertest": "^6.3.3",
    "ws": "^8.14.2",
    "sinon": "^17.0.1",
    "nyc": "^15.1.0",
    "jest-websocket-mock": "^2.5.0",
    "mock-fs": "^5.2.0"
  },
  "keywords": ["mcp", "ai", "conversations", "chatgpt", "grok", "gemini", "claude", "aegntic", "hive", "projects", "artifacts", "versioning", "parallel-processing", "authentication", "monitoring", "performance"],
  "author": {
    "name": "Mattae Cooper",
    "email": "research@aegntic.ai",
    "url": "https://aegntic.ai"
  },
  "contributors": [
    {
      "name": "Mattae Cooper",
      "email": "research@aegntic.ai",
      "role": "Lead Researcher & System Architect"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aegntic/aegntic-hive-mcp.git"
  },
  "homepage": "https://github.com/aegntic/aegntic-hive-mcp#readme",
  "bugs": {
    "url": "https://github.com/aegntic/aegntic-hive-mcp/issues",
    "email": "research@aegntic.ai"
  }
}
